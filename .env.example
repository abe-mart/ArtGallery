# Copy this file to .env for local development with `netlify dev`.
# On Netlify itself, set this in Site Settings > Environment Variables
# (or you'll be asked for it automatically if you use the "Deploy to
# Netlify" button).

# Required: the password for your admin panel at /admin.
ADMIN_PASSWORD=

# Nothing else to configure! Everything else (the signing secret for
# login sessions, your site title, artist name, and the optional viewer
# PIN) is generated automatically or set from the Settings tab in /admin.
